# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- gateway (LiteLLM, OpenAI-compatible) ---
LITELLM_BASE_URL=https://your-gateway.example.com
LITELLM_API_KEY=replace-me
# Prefix for model aliases: "{APP_NAME}-{writer-slug}"
APP_NAME=writersguild
# Optional: alias every seeded writer uses when the gateway has no per-writer aliases
DEFAULT_MODEL_ALIAS=lumos-chat

# --- first account (admin), created once at first start ---
APP_USERNAME=admin
APP_PASSWORD=replace-me-with-at-least-8-chars

# --- database (docker-compose) ---
POSTGRES_PASSWORD=replace-me
# The app container derives DATABASE_URL from POSTGRES_PASSWORD (see docker-compose.yml).
# For running the binary outside docker, set it explicitly:
# DATABASE_URL=postgres://writersguild:${POSTGRES_PASSWORD}@127.0.0.1:5433/writersguild?sslmode=disable

# --- tests ---
# Integration tests run only when this is set (a separate database on the same server):
# TEST_DATABASE_URL=postgres://writersguild:${POSTGRES_PASSWORD}@127.0.0.1:5433/writersguild_test?sslmode=disable

# --- optional tuning ---
# PORT=8080
# LLM_TIMEOUT_SECONDS=120
